# Facultatif, uniquement pour utiliser un Chrome installé localement.
# Linux x64 et Vercel : laisser vide pour utiliser @sparticuz/chromium.
CHROME_EXECUTABLE_PATH=

# Rapports IA et CPS IA — variables serveur uniquement (aucun préfixe NEXT_PUBLIC_).
# Région d’appel AWS Bedrock, par exemple us-east-1 ou eu-west-3.
AWS_REGION=
# Clé API Amazon Bedrock créée dans la console AWS (pas une clé API Anthropic).
AWS_BEARER_TOKEN_BEDROCK=
# Profil d’inférence Claude Sonnet 4.6. Le profil global peut router hors de la région d’appel.
# Alternative Europe, si adaptée à votre compte : eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Stockage des documents — Drive partagé Google Workspace dédié à Exnov workspace.
# Compte de service membre du Drive comme Gestionnaire de contenu.
# Aucune délégation de domaine. Variables serveur uniquement.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clé PEM : retours à la ligne réels ou séquences \n acceptés.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Identifiant du dossier situé dans le Drive partagé (pas Mon Drive).
GOOGLE_DRIVE_FOLDER_ID=

# Espace équipe — PostgreSQL Neon et connexion e-mail/mot de passe.
# DATABASE_URL: connexion poolée. DIRECT: même base, connexion directe pour administration.
DATABASE_URL=
DATABASE_DIRECT_URL=
BETTER_AUTH_URL=http://localhost:3000
# Générer un secret avec openssl rand -base64 48.
BETTER_AUTH_SECRET=
# Laisser false en équipe ; true active seulement la démonstration locale.
EXNOV_DEMO_MODE=false
TEAM_AI_DAILY_LIMIT=50

# Uniquement pour db:bootstrap, puis retirer ces trois valeurs.
EXNOV_ADMIN_NAME=
EXNOV_ADMIN_EMAIL=
EXNOV_ADMIN_PASSWORD=
