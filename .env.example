# Facultatif, uniquement pour utiliser un Chrome installé localement.
# Linux x64 et Vercel : laisser vide pour utiliser @sparticuz/chromium.
CHROME_EXECUTABLE_PATH=

# Rapports IA et CPS IA — variables serveur uniquement (aucun préfixe NEXT_PUBLIC_).
# Région d’appel AWS Bedrock, par exemple us-east-1 ou eu-west-3.
AWS_REGION=
# Clé API Amazon Bedrock créée dans la console AWS (pas une clé API Anthropic).
AWS_BEARER_TOKEN_BEDROCK=
# Profil d’inférence Claude Sonnet 4.6. Le profil global peut router hors de la région d’appel.
# Alternative Europe, si adaptée à votre compte : eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
