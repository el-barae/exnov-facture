{
  "name": "exnov-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --import ./scripts/helpers/demo-test-env.ts --test tests/*.test.ts",
    "test:e2e": "node --import tsx scripts/verify-exports.ts",
    "test:reports": "node --import tsx scripts/verify-reports.ts",
    "test:theme": "node --import tsx scripts/verify-theme.ts",
    "test:login": "node --import tsx scripts/verify-login.ts",
    "test:project-plans": "node --import tsx scripts/verify-project-plans.ts",
    "test:project-documents": "node --import tsx scripts/verify-project-documents.ts",
    "test:projects": "node --import tsx scripts/verify-projects.ts",
    "test:plans-ai": "node --import tsx scripts/verify-plans-ai.ts",
    "test:plans-architecture": "node --import tsx scripts/verify-plans-architecture.ts",
    "test:plans": "node --import tsx scripts/verify-plans.ts",
    "test:cps": "node --import tsx scripts/verify-cps.ts",
    "test:workflow": "node --import tsx scripts/verify-workflow-tasks.ts",
    "test:team": "node --conditions=react-server --import tsx scripts/verify-team.ts",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "db:bootstrap": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/db-bootstrap.ts",
    "files:cleanup": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/files-cleanup.ts",
    "test:project-import": "node --import tsx scripts/verify-project-import.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium": "153.0.0",
    "better-auth": "^1.7.6",
    "decimal.js": "^10.6.0",
    "docxtemplater": "3.71.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "pizzip": "3.3.0",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
